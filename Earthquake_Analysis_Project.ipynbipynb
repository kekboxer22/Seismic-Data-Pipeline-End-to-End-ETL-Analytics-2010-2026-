  {
   "cell_type": "markdown",
   "id": "90c30ee7-0b12-48ef-8837-db7b96dcac63",
   "metadata": {},
   "source": [
    "# STEP 1 Import"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "0793a928-2ec7-4883-b595-b2c8e106d099",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.dates as mdates\n",
    "import seaborn as sns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "176ee3ff-157d-4d2f-b231-401ac643b1a6",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.read_csv('earthquakes_1900_2026.csv')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e9e30208-96ef-40f2-9bbb-c37a5eb3ad6b",
   "metadata": {},
   "source": [
    "# STEP 2 INITIAL DATA AUDIT"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "c90faab0-d92e-4734-bafa-3f3d26cd1e48",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset Dimensions: 1,054,012 rows x 23 columns\n",
      "Total Data Points: 24,242,276\n",
      "\n",
      "--- Integrity Check (Missing Values) ---\n",
      "mag            0\n",
      "year           0\n",
      "day_of_year    0\n",
      "place          0\n",
      "dtype: int64\n",
      "\n",
