      "longitude      float64\n",
      "depth          float64\n",
      "mag            float64\n",
      "dtype: object\n"
     ]
    }
   ],
   "source": [
    "# Checking the raw dataset scale before any transformations\n",
    "rows, cols = df.shape\n",
    "total_cells = df.size\n",
    "\n",
    "print(f\"Dataset Dimensions: {rows:,} rows x {cols} columns\")\n",
    "print(f\"Total Data Points: {total_cells:,}\")\n",
    "\n",
    "# Verification of critical columns for seismic analysis\n",
    "critical_features = ['mag', 'year', 'day_of_year', 'place']\n",
    "missing_values = df[critical_features].isnull().sum()\n",
    "\n",
    "print(\"\\n--- Integrity Check (Missing Values) ---\")\n",
    "print(missing_values)\n",
    "\n",
    "# Inspecting data types to ensure correct parsing\n",
    "print(\"\\n--- Schema Overview ---\")\n",
    "print(df.dtypes.head(10)) # Focus on the first 10 columns for brevity"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f9f6bc04-7ffb-456f-b5d1-870c1fbe709e",
   "metadata": {},
   "source": [
    "# Data info(Sort >200y) Costomizing date columns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "8878fae0-ce6b-42bc-b14b-0758f95b82e9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Tota: 433269\n",
      "2010-01-01 02:00:00  ->  2026-03-28 22:00:00\n"
     ]
    }
   ],
   "source": [
    "df[\"date\"] = pd.to_datetime(\n",
    "    df[\"year\"].astype(str) + \"-\" + df[\"day_of_year\"].astype(str),\n",
    "    format=\"%Y-%j\"\n",
    ")\n",
    "df[\"date\"] = df[\"date\"] + pd.to_timedelta(df[\"hour\"], unit=\"h\")\n",
    "df = df[df['date'].dt.year >= 2010]\n",
    "print(f\"Tota: {len(df)}\")\n",
    "print(df['date'].min(), \" -> \", df['date'].max())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a458d837-9174-4686-9667-afebafa97a15",
   "metadata": {},
   "source": [
    "### End-to-End ETL Engine (Python & PostgreSQL)\n",
    "\n",
    "## Project Overview\n",
    "\n",
    "This project implements a robust ETL (Extract, Transform, Load) pipeline for processing global seismic activity logs.\n",
    "It transforms a massive raw dataset into a cleaned, optimized PostgreSQL database, followed by deep analytical visualization of earthquake dynamics.\n",
    "\n",
    "- **Raw Data:** ~700,000 records (1900-2026).\n",
    "- **Processed Data:** 433,269 high-precision records (2010-2026).\n"
   ]
  },
